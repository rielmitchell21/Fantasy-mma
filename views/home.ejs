<%- include("partials/header", { title, currentUser, flash }) %>

<section class="hero card">
  <h1>Build your year-long fantasy UFC league</h1>
  <p>
    Draft UFC-contracted fighters, track results, and score each winning fighter up to
    <strong>6 points</strong> based on your league rules.
  </p>
  <div class="hero-actions">
    <a class="button" href="/signup">Create account</a>
    <a class="button button-secondary" href="/login">Log in</a>
  </div>
</section>

<section class="card">
  <h2>Scoring rules implemented</h2>
  <ul>
    <li>1 point for a win</li>
    <li>+1 for finish</li>
    <li>+1 for 5-round fight</li>
    <li>+1 for championship fight</li>
    <li>+1 for fighting a ranked fighter</li>
    <li>+1 for vacating a title to move divisions and fighting for the title</li>
    <li>If a fighter loses, they get 0 points</li>
  </ul>
</section>

<section class="card">
  <h2>League constraints</h2>
  <ul>
    <li>5-10 users per league</li>
    <li>15-20 fighters per user roster</li>
    <li>Draft start date triggers the season</li>
    <li>Only fights in the year after draft start are counted</li>
    <li>No fights before draft start count</li>
  </ul>
</section>

<%- include("partials/footer") %>
