<%- include("partials/header", { title, currentUser, flash }) %>

<section class="grid-two">
  <article class="card">
    <h2>Create league</h2>
    <form action="/leagues/create" method="post" class="form-grid">
      <label>
        League name
        <input name="name" type="text" required />
      </label>
      <label>
        Max users (5-10)
        <input name="maxUsers" type="number" min="5" max="10" value="10" required />
      </label>
      <label>
        Roster size per user (15-20)
        <input name="rosterSize" type="number" min="15" max="20" value="15" required />
      </label>
      <button type="submit" class="button">Create league</button>
    </form>
  </article>

  <article class="card">
    <h2>Join league</h2>
    <form action="/leagues/join" method="post" class="form-grid">
      <label>
        Invite code
        <input name="inviteCode" type="text" maxlength="6" required />
      </label>
      <button type="submit" class="button">Join league</button>
    </form>
  </article>
</section>

<section class="card">
  <h2>Your leagues</h2>
  <% if (leagues.length === 0) { %>
    <p>You are not in any leagues yet.</p>
  <% } else { %>
    <div class="league-list">
      <% leagues.forEach((league) => { %>
        <a class="league-item" href="/leagues/<%= league.id %>">
          <h3><%= league.name %></h3>
          <p><strong>Invite:</strong> <%= league.invite_code %></p>
          <p><strong>Members:</strong> <%= league.member_count %> / <%= league.max_users %></p>
          <% if (league.draft_started_at) { %>
            <p><strong>Season:</strong> <%= league.draft_started_at %> to <%= league.season_ends_at %></p>
          <% } else { %>
            <p><strong>Status:</strong> Draft not started</p>
          <% } %>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>
